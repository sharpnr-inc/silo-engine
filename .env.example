# Copy this file to .env.development (or .env.production) and fill in real values.
#
# Which file gets loaded is decided by APP_ENV, which defaults to "development".
# APP_ENV must be set in the shell/service definition, NOT in this file --
# it is what selects the file, so it is read before any of these values exist.
#
#   cargo run                     -> loads .env.development
#   APP_ENV=production cargo run  -> loads .env.production
#
# A missing env file is only a warning; the app then reads the process
# environment instead. Real environment variables always win over this file.

# Which environment this file describes.
# Setting it here does NOT choose the file -- that already happened by the time
# this is read. Set APP_ENV in the shell to switch files; this line is the
# in-file record of which environment you are looking at.
APP_ENV=development

# This is the Port for Where this App will run
# Required -- the app exits at startup if this is missing or not a valid port.
SILO_ENGINE_PORT=9254

# This is the Port Where Sharpnr Engine is Running
SHARPNR_ENGINE_PORT=8080

# Database Configuration
